# Copy to /etc/car-scanner.env and chmod 600. Never commit the real file.
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_CHAT_ID=123456789
CAR_SCANNER_DB=/opt/car-scanner/listings.db
# Rotating JSON log (10 MB x 5 backups). Must be writable by the service user.
CAR_SCANNER_LOG=/opt/car-scanner/car-scanner.log

# Residential proxy for AutoTrader fetches (searches + lifespan re-checks).
# AutoTrader's WAF blanket-403s hosting/VPS IP ranges (DigitalOcean included),
# so a droplet needs this; leave empty when running from a home connection.
# Standard proxy URL: http://username:password@gateway-host:port
# Budget ~3-5 GB/month of proxy bandwidth at the default poll cadence.
AUTOTRADER_PROXY_URL=

# AI verification (optional). Empty = feature off, alerts send unchanged.
# Get a key at console.anthropic.com; runs only on alert-bound listings
# (~1-5/day), so expect $1-5/month. Requires: pip install anthropic
ANTHROPIC_API_KEY=
# Kill switch for the AI gate; 0 disables even with a key set.
AI_VERIFY_ENABLED=1

# FB->droplet ingest bridge. Generate a token with: openssl rand -hex 24
# Leave INGEST_TOKEN empty to disable the ingest server entirely.
# Open the port (ufw allow 8477/tcp) or better, restrict it to your home IP.
# The userscript posts over plain HTTP: the bearer token is the only
# protection, so treat it as disposable.
INGEST_TOKEN=
INGEST_BIND=0.0.0.0:8477
